{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "murmur",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // 本体の API はゲートウェイからの Service Binding 経由で呼ばれる。
  // 公開するのは Webhook と timeline.html だけ（どちらもアプリ層で鍵を検証する）。
  "workers_dev": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "CLAUDE_MODEL": "claude-sonnet-5-5",
    "IDENTITY_AUDIENCE": "murmur"
    // GATEWAY_JWKS はゲートウェイの <PUBLIC_URL>/.well-known/jwks.json の中身、IDENTITY_ISSUER はゲートウェイの PUBLIC_URL。
    // 秘密ではないが env ごとに違うので env 側で設定する
  },
  // secrets: ANTHROPIC_API_KEY, WEBHOOK_SECRET, TIMELINE_TOKEN
  // D1（0021）: d1_databases は env ごとに書く（env に継承されない）。database_id は
  //   wrangler d1 create murmur-dev --location apac の出力。マイグレーションは pnpm db:migrate <env>（drizzle/ を当てる）
  "env": {
    "dev": {
      "name": "murmur-dev",
      // H7 で Webhook にシグナルを流し、timeline.html を見るために workers.dev を開ける。/api/* は JWT 必須のまま
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "CLAUDE_MODEL": "claude-sonnet-5-5",
        "IDENTITY_AUDIENCE": "murmur",
        "IDENTITY_ISSUER": "https://api-gateway-mcp.nose-0d2.workers.dev",
        "GATEWAY_JWKS": "{\"keys\":[{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"x\":\"MiS4fsNuFhRhzlIQVbAX3623EaYblKi4uXkaeAPBhrw\",\"kid\":\"KNBlv8ntIyJzelvRChDnIPMD9d1Eavr1BoXeJE7gYq0\",\"alg\":\"EdDSA\",\"use\":\"sig\"}]}"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "murmur-dev", "database_id": "c74085ea-ccd1-4779-871a-b585afd7624d", "migrations_dir": "drizzle" }
      ],
      "triggers": { "crons": ["*/5 * * * *"] }
    },
    "prod": {
      "name": "murmur",
      "vars": {
        "CLAUDE_MODEL": "claude-sonnet-5-5",
        "IDENTITY_AUDIENCE": "murmur",
        "IDENTITY_ISSUER": "",
        "GATEWAY_JWKS": ""
      },
      "d1_databases": [
        // TODO: wrangler d1 create murmur --location apac の database_id に置き換える
        { "binding": "DB", "database_name": "murmur", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "drizzle" }
      ],
      "triggers": { "crons": ["*/5 * * * *"] }
    }
  }
}
