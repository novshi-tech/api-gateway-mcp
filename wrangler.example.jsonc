{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-gateway-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  // Purges expired OAuth grants and tokens.
  "triggers": { "crons": ["0 18 * * *"] },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "durable_objects": {
    "bindings": [{ "name": "VAULT", "class_name": "UserVault" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserVault"] }],
  "vars": {
    // Public origin of this Worker, without a trailing slash.
    "PUBLIC_URL": "http://localhost:8787",
    // "entra" or "google".
    "IDP_TYPE": "entra",
    // Entra: https://login.microsoftonline.com/<tenant-id>/v2.0
    // Google: https://accounts.google.com
    "OIDC_ISSUER": "https://login.microsoftonline.com/REPLACE_WITH_TENANT_ID/v2.0",
    "OIDC_CLIENT_ID": "REPLACE_WITH_CLIENT_ID",
    // Comma-separated. Entra: tenant IDs. Google: Workspace domains (required).
    "ALLOWED_TENANTS": "",
    "ALLOWED_DOMAINS": "",
    "SERVICES": {
      "board": {
        "base_url": "https://api.the-board.jp",
        "auth": {
          "type": "headers",
          "headers": [
            { "name": "x-api-key", "label": "API キー" },
            { "name": "authorization", "label": "API トークン", "prefix": "Bearer " }
          ]
        }
      },
      // OAuth: register ${PUBLIC_URL}/connect/callback as the redirect URI and set
      // OAUTH_FREEE_CLIENT_ID and OAUTH_FREEE_CLIENT_SECRET with wrangler secret put.
      "freee": {
        "base_url": "https://api.freee.co.jp",
        "auth": {
          "type": "oauth2",
          "authorization_url": "https://accounts.secure.freee.co.jp/public_api/authorize",
          "token_url": "https://accounts.secure.freee.co.jp/public_api/token"
        }
      }
    }
  }
  // Secrets (wrangler secret put): OIDC_CLIENT_SECRET, SIGNING_KEY, ENCRYPTION_KEY,
  // and OAUTH_<SERVICE>_CLIENT_ID / OAUTH_<SERVICE>_CLIENT_SECRET for each OAuth service
}
