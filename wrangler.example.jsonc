{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-gateway-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  // Purges expired OAuth grants and tokens.
  "triggers": { "crons": ["0 18 * * *"] },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "durable_objects": {
    "bindings": [{ "name": "VAULT", "class_name": "UserVault" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserVault"] }],
  "vars": {
    // Public origin of this Worker, without a trailing slash.
    "PUBLIC_URL": "http://localhost:8787",
    // "entra" or "google".
    "IDP_TYPE": "entra",
    // Entra: https://login.microsoftonline.com/<tenant-id>/v2.0
    // Google: https://accounts.google.com
    "OIDC_ISSUER": "https://login.microsoftonline.com/REPLACE_WITH_TENANT_ID/v2.0",
    "OIDC_CLIENT_ID": "REPLACE_WITH_CLIENT_ID",
    // Comma-separated. Entra: tenant IDs. Google: Workspace domains (required).
    "ALLOWED_TENANTS": "",
    "ALLOWED_DOMAINS": "",
    "SERVICES": {
      "board": {
        "base_url": "https://api.the-board.jp",
        "auth": {
          "type": "headers",
          "headers": [
            { "name": "x-api-key", "label": "API キー" },
            { "name": "authorization", "label": "API トークン", "prefix": "Bearer " }
          ]
        }
      },
      // gBizINFO: the API token comes from the Web API application at info.gbiz.go.jp.
      "gbizinfo": {
        "display_name": "gBizINFO",
        "base_url": "https://api.info.gbiz.go.jp",
        "auth": {
          "type": "headers",
          "headers": [{ "name": "X-hojinInfo-api-token", "label": "gBizINFO の API トークン" }]
        }
      },
      // OAuth: register ${PUBLIC_URL}/connect/callback as the redirect URI and set
      // OAUTH_FREEE_CLIENT_ID and OAUTH_FREEE_CLIENT_SECRET with wrangler secret put.
      "freee": {
        "base_url": "https://api.freee.co.jp",
        "auth": {
          "type": "oauth2",
          "authorization_url": "https://accounts.secure.freee.co.jp/public_api/authorize",
          "token_url": "https://accounts.secure.freee.co.jp/public_api/token"
        }
      },
      // Google OAuth: enable Gmail API / Google Drive API and register
      // ${PUBLIC_URL}/connect/callback as a Web application redirect URI.
      // Set OAUTH_GMAIL_CLIENT_ID / _SECRET and OAUTH_DRIVE_CLIENT_ID / _SECRET.
      "gmail": {
        "display_name": "Gmail",
        "base_url": "https://gmail.googleapis.com",
        "auth": {
          "type": "oauth2",
          "authorization_url": "https://accounts.google.com/o/oauth2/v2/auth",
          "token_url": "https://oauth2.googleapis.com/token",
          "scope": "https://www.googleapis.com/auth/gmail.modify",
          "authorize_params": { "access_type": "offline", "prompt": "consent" }
        }
      },
      "drive": {
        "display_name": "Google Drive",
        "base_url": "https://www.googleapis.com",
        "auth": {
          "type": "oauth2",
          "authorization_url": "https://accounts.google.com/o/oauth2/v2/auth",
          "token_url": "https://oauth2.googleapis.com/token",
          "scope": "https://www.googleapis.com/auth/drive",
          "authorize_params": { "access_type": "offline", "prompt": "consent" }
        }
      },
      // Google Calendar: enable Calendar API, then set
      // OAUTH_CALENDAR_CLIENT_ID and OAUTH_CALENDAR_CLIENT_SECRET.
      "calendar": {
        "display_name": "Google Calendar",
        "base_url": "https://www.googleapis.com",
        "auth": {
          "type": "oauth2",
          "authorization_url": "https://accounts.google.com/o/oauth2/v2/auth",
          "token_url": "https://oauth2.googleapis.com/token",
          "scope": "https://www.googleapis.com/auth/calendar.events https://www.googleapis.com/auth/calendar.calendarlist.readonly https://www.googleapis.com/auth/calendar.events.freebusy",
          "authorize_params": { "access_type": "offline", "prompt": "consent" }
        }
      },
      // Microsoft Graph with a separate Entra app: register ${PUBLIC_URL}/connect/callback as a
      // Web redirect URI and set OAUTH_GRAPH_CLIENT_ID and OAUTH_GRAPH_CLIENT_SECRET.
      "graph": {
        "display_name": "Microsoft Graph",
        "base_url": "https://graph.microsoft.com",
        "auth": {
          "type": "oauth2",
          "authorization_url": "https://login.microsoftonline.com/REPLACE_WITH_TENANT_ID/oauth2/v2.0/authorize",
          "token_url": "https://login.microsoftonline.com/REPLACE_WITH_TENANT_ID/oauth2/v2.0/token",
          "scope": "offline_access User.Read Files.ReadWrite.All Sites.ReadWrite.All Mail.ReadWrite Mail.Send Calendars.ReadWrite Chat.ReadWrite ChannelMessage.Send ChannelMessage.Read.All Team.ReadBasic.All Channel.ReadBasic.All"
        }
      }
    }
  }
  // Secrets (wrangler secret put): OIDC_CLIENT_SECRET, SIGNING_KEY, ENCRYPTION_KEY,
  // and OAUTH_<SERVICE>_CLIENT_ID / OAUTH_<SERVICE>_CLIENT_SECRET for each OAuth service
}
