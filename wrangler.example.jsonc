{
  // デプロイの設定のひな形（docs/adr/0029）。pnpm dev・CI のドライランはこれを使う。
  // デプロイは deployments/<名前>.jsonc で行う（deployments/ は git の管理外。デプロイする人の private リポジトリを clone する）。
  // ひな形からデプロイの設定を作るときは、$schema・main・migrations_dir のパスの先頭に ../ を付ける。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "murmur",
  // デプロイの設定では必ず書く（複数のアカウントが見えると wrangler が聞いてきて止まる）
  // "account_id": "<Cloudflare のアカウント ID>",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // 本体の API はゲートウェイからの Service Binding 経由で呼ばれる。
  // 公開するのは Webhook と管理画面（/admin・timeline.html）だけ（どちらもアプリ層で鍵を検証する）。
  // 受信の Webhook を使うデプロイは true にする。/api/* は JWT 必須のまま
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "CLAUDE_MODEL": "claude-sonnet-5-5",
    "IDENTITY_AUDIENCE": "murmur",
    // ゲートウェイの PUBLIC_URL と、<PUBLIC_URL>/.well-known/jwks.json の中身（docs/adr/0003）
    "IDENTITY_ISSUER": "https://gateway.example.com",
    "GATEWAY_JWKS": "{\"keys\":[]}"
  },
  // D1（0021）: wrangler d1 create murmur --location apac の出力の database_id を書く。
  // マイグレーションは pnpm db:migrate <名前>（drizzle/ を当てる）
  "d1_databases": [
    { "binding": "DB", "database_name": "murmur", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "drizzle" }
  ]
  // secrets（pnpm secret <名前> put <KEY>）: ANTHROPIC_API_KEY, WEBHOOK_SECRET, TIMELINE_TOKEN
  //
  // 外部コネクタ（個人の箱の Outlook、docs/adr/0024）。使わないデプロイは何も書かなくてよい。
  // vars の PUBLIC_URL（本体の公開 URL。workers_dev か routes で公開する）と、secret の TOKEN_KEY
  // （openssl rand -base64 32。ゲートウェイのリフレッシュトークンを包む）がそろうと有効になる。
  // ゲートウェイの URL は GATEWAY_URL（省けば IDENTITY_ISSUER）、Graph のサービス名は GRAPH_SERVICE（省けば graph）。
  // 取り込みのキューは wrangler queues create <名前>-sync で作ってから、次を足す（consumer は同時実行 1 で直列にする）:
  //   "queues": {
  //     "producers": [{ "binding": "SYNC_QUEUE", "queue": "<名前>-sync" }],
  //     "consumers": [{ "queue": "<名前>-sync", "max_batch_size": 10, "max_batch_timeout": 1, "max_concurrency": 1, "max_retries": 5 }]
  //   }
  // ゲートウェイが同じアカウントの workers.dev にあると公開 URL への fetch が通らない（1042）ので、
  //   "services": [{ "binding": "GATEWAY_WEB", "service": "<ゲートウェイの Worker 名>" }] でデフォルトの入口に行く
}
