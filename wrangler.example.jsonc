{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-gateway-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  // "0 18 * * *" purges expired OAuth grants and tokens (src/index.ts PURGE_CRON). With Murmur,
  // add its tick: ["0 18 * * *", "*/5 * * * *"].
  "triggers": { "crons": ["0 18 * * *"] },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "durable_objects": {
    "bindings": [
      { "name": "VAULT", "class_name": "UserVault" },
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserVault"] },
    { "tag": "v2", "new_sqlite_classes": ["Registry"] }
  ],
  "vars": {
    // Public origin of this Worker, without a trailing slash.
    "PUBLIC_URL": "http://localhost:8787",
    // The organization this deployment serves, e.g. "Acme". Claude and the web UI show it so that
    // gateways of several organizations connected side by side can be told apart (docs/adr/0004).
    // Defaults to the host of PUBLIC_URL.
    "ORGANIZATION_NAME": "",
    // "entra" or "google".
    "IDP_TYPE": "entra",
    // Entra: https://login.microsoftonline.com/<tenant-id>/v2.0
    // Google: https://accounts.google.com
    "OIDC_ISSUER": "https://login.microsoftonline.com/REPLACE_WITH_TENANT_ID/v2.0",
    "OIDC_CLIENT_ID": "REPLACE_WITH_CLIENT_ID",
    // Comma-separated. Entra: tenant IDs. Google: Workspace domains (required).
    "ALLOWED_TENANTS": "",
    "ALLOWED_DOMAINS": "",
    // Comma-separated user IDs (under "アカウントの情報" on the web UI's home page) who may manage services.
    "ADMINS": "",
    // Entra tenant ID for Microsoft Graph. Graph is offered only when this is set.
    "MICROSOFT_TENANT_ID": "",
    // Built-in services (src/catalog.ts): freee, Microsoft Graph, Gmail, Google Drive,
    // Google Calendar, Google Docs, Google Analytics, Slack, Jira, board, gBizINFO and Serper.
    // Add your own here; an entry with a built-in name replaces that service.
    "SERVICES": {
      // "example": {
      //   "display_name": "Example",
      //   "base_url": "https://api.example.com",
      //   "auth": { "type": "headers", "headers": [{ "name": "X-API-Key", "label": "Example の API キー" }] }
      // }
    }
  }
  // Secrets (wrangler secret put): OIDC_CLIENT_SECRET, SIGNING_KEY, ENCRYPTION_KEY, and
  // OAUTH_<CLIENT>_CLIENT_ID / _CLIENT_SECRET for each OAuth client you use: FREEE (freee),
  // GOOGLE (Gmail, Drive, Calendar, Docs, Analytics), MICROSOFT (Graph), SLACK (Slack) and
  // ATLASSIAN (Jira). For your own OAuth
  // services, <CLIENT> is the service's "client", or its name.
  // IDENTITY_SIGNING_KEY (an Ed25519 private JWK) is needed only for services whose auth type is "identity".
  // Such a service may be reached through a Service Binding: add "binding": "<NAME>" to it and
  // "services": [{ "binding": "<NAME>", "service": "<worker name>" }] here.
  // Services whose auth type is "client_credentials" are reached only by other Workers on this
  // account, through the named entrypoint "Background": the caller adds
  // { "binding": "GATEWAY", "service": "<this worker's name>", "entrypoint": "Background" }.
  // Murmur (docs/adr/0005): the team's work memory, a feature of this Worker. Leave it out and the
  // gateway works as before. To turn it on, add:
  //   "d1_databases": [{ "binding": "MURMUR_DB", "database_name": "<name>-murmur", "database_id": "...", "migrations_dir": "murmur/drizzle" }],
  //   "queues": {
  //     "producers": [{ "binding": "MURMUR_QUEUE", "queue": "<name>-murmur-sync" }],
  //     "consumers": [{ "queue": "<name>-murmur-sync", "max_batch_size": 10, "max_batch_timeout": 1, "max_concurrency": 1, "max_retries": 5 }]
  //   },
  // the "*/5 * * * *" cron above, and the secrets ANTHROPIC_API_KEY and MURMUR_WEBHOOK_SECRET
  // (openssl rand -base64 32; Graph and Jira webhooks), optionally MURMUR_TIMELINE_TOKEN (its operator pages).
  // Optional vars: MURMUR_CLAUDE_MODEL, MURMUR_GRAPH_SERVICE (default graph), MURMUR_JIRA_SERVICE (default jira),
  // MURMUR_SHARED_SERVICES (services whose spaces may become shared lists, e.g. "jira,teams"; none by default. Murmur's 0037).
  // Create the database and queue with `npx wrangler d1 create <name>-murmur` and `npx wrangler queues create <name>-murmur-sync`,
  // then `npm run d1-migrate -- <name>` before deploying.
}
