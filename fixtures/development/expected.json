        { "as": "u_nose", "thread": "$issueThread", "access": "full", "candidates": [] },
        { "as": "u_kato", "thread": "$issueThread", "access": "full", "candidates": [], "mustContain": ["$clientThread"], "mustNotContain": ["500 エラーが出ます"] }
      ]
    },
    {
      "after": "o04",
      "threads": {
        "$regThread": { "dataSourceId": "ds_jira", "title": "ログインの回帰テストを追加", "ball": { "kind": "party", "partyIds": ["p_kato"] }, "signalCount": 1, "links": { "$clientThread": "sent" } },
        "$clientThread": { "links": { "$issueThread": "anchor", "$regThread": "sent" } }
      }
    },
    { "after": "c01", "threads": { "$regThread": { "signalCount": 1 } } },
    {
      "after": "m05",
      "threads": { "$regThread": { "attributes": { "status": "未着手", "assignee": "p_kato", "priority": "中", "done": false } } },
      "views": [
        { "as": "u_kato", "threads": { "filter": "my_turn" }, "expect": ["$regThread"] },
        { "as": "u_kato", "thread": "$regThread", "access": "full", "item": { "turn": { "kind": "user", "userIds": ["u_kato"], "by": "assignee" } } },
        { "as": "u_nose", "thread": "$clientThread", "access": "full", "mustContain": ["ログインの回帰テストを追加"] }
      ]
    },
    {
      "after": "o05",
      "threads": { "$regThread": { "ball": { "kind": "party", "partyIds": ["p_nose"] }, "signalCount": 2 } },
      "views": [{ "as": "u_kato", "thread": "$regThread", "access": "full", "item": { "turn": { "kind": "user", "userIds": ["u_kato"], "by": "assignee" } } }]
    },
    { "after": "c02", "threads": { "$regThread": { "ball": { "kind": "party", "partyIds": ["p_kato"] }, "signalCount": 3 } } },
    {
      "after": "m06",
      "threads": { "$regThread": { "ball": { "kind": "none" }, "closedAtSource": true } },
      "views": [{ "as": "u_kato", "threads": { "filter": "my_turn" }, "expect": [] }]
    }
  ],
  "final": {
    "threads": {
      "$clientThread": {
        "dataSourceId": "ds_slack_client",
        "ball": { "kind": "party", "partyIds": ["p_mori"] },
        "counterpartPartyIds": ["p_mori"],
        "signalCount": 6,
        "unansweredSince": null,
        "links": { "$issueThread": "anchor", "$regThread": "sent" }
      },
      "$issueThread": {
        "dataSourceId": "ds_jira",
        "ball": { "kind": "none" },
        "counterpartPartyIds": ["p_jira"],
        "signalCount": 2,
        "closedAtSource": true,
        "attributes": { "status": "完了", "assignee": "p_kato", "priority": "高", "done": true },
        "links": { "$clientThread": "anchor", "$prThread": "anchor" }
      },
      "$prThread": { "dataSourceId": "ds_bitbucket", "ball": { "kind": "none" }, "dismissed": true, "signalCount": 2, "links": { "$issueThread": "anchor" } },
      "$pipelineThread": { "dataSourceId": "ds_bitbucket", "ball": { "kind": "none" }, "signalCount": 1 },
      "$docThread": { "dataSourceId": "ds_jira", "ball": { "kind": "none" }, "signalCount": 1, "links": {}, "closedAtSource": false },
      "$regThread": {
        "dataSourceId": "ds_jira",
        "ball": { "kind": "none" },
        "closedAtSource": true,
        "signalCount": 3,
        "counterpartPartyIds": ["p_kato", "p_nose"],
        "attributes": { "status": "完了", "assignee": "p_kato", "priority": "中", "done": true },
        "links": { "$clientThread": "sent" }
      }
    },
    "threadCount": 6,
    "eventCounts": { "SignalObserved": 13, "SignalThreaded": 15, "OutboundRecorded": 2, "ThreadMirrored": 6, "ThreadDismissed": 1, "ThreadLinked": 3 }
  },
  "visibility": [
    { "as": "u_nose", "thread": "$clientThread", "access": "full", "mustContain": ["500 エラー", "screenshot.png"] },
    { "as": "u_kato", "thread": "$clientThread", "access": null },
    { "as": "u_kato", "thread": "$issueThread", "access": "full", "mustContain": ["NVT-42"] },
    { "as": "u_ubs_only", "thread": "$issueThread", "access": null },
    { "as": "u_nose", "signals": 15 },
    { "as": "u_kato", "signals": 9 },
    { "as": "u_ubs_only", "signals": 0 },
    { "as": "u_kato", "threads": { "filter": "open" }, "expect": ["$pipelineThread", "$docThread"] },
    { "as": "u_kato", "threads": { "filter": "all", "dataSource": "ds_jira" }, "expect": ["$issueThread", "$docThread", "$regThread"] },
    { "as": "u_nose", "threads": { "filter": "triage" }, "expect": [] },
    { "as": "u_nose", "threads": { "filter": "all", "dataSource": "ds_bitbucket" }, "expect": ["$prThread", "$pipelineThread"] },
    { "ghostParty": "p_mori" },
    { "as": "u_nose", "thread": "$docThread", "access": "full", "candidates": ["$clientThread"] },
    { "as": "u_kato", "thread": "$docThread", "access": "full", "candidates": [] },
    { "as": "u_nose", "threads": { "filter": "my_turn" }, "expect": ["$docThread"] },
    { "as": "u_nose", "thread": "$docThread", "access": "full", "item": { "turn": { "kind": "user", "userIds": ["u_nose"], "by": "assignee" } } }
  ]
