      ]
    },
    { "after": "s02", "threads": { "$clientThread": { "ball": { "kind": "us" }, "signalCount": 2 } } },
    { "after": "o01", "threads": { "$clientThread": { "ball": { "kind": "party", "partyIds": ["p_mori"] } } } },
    {
      "after": "s04",
      "threads": { "$prThread": { "ball": { "kind": "us" } } },
      "views": [
        { "as": "u_nose", "thread": "$issueThread", "access": "full", "candidates": ["$prThread"] },
        { "as": "u_kato", "thread": "$prThread", "access": "full", "candidates": ["$issueThread"] }
      ]
    },
    {
      "after": "m01",
      "threads": { "$issueThread": { "ball": { "kind": "none" }, "attributes": { "status": "未着手", "assignee": "p_kato", "priority": "高", "done": false }, "closedAtSource": false } },
      "views": [
        { "as": "u_kato", "thread": "$issueThread", "access": "full", "item": { "turn": { "kind": "user", "userIds": ["u_kato"], "by": "assignee" } } },
        { "as": "u_kato", "threads": { "filter": "my_turn" }, "expect": ["$issueThread"] },
        { "as": "u_nose", "threads": { "filter": "my_turn", "dataSource": "ds_jira" }, "expect": [] }
      ]
    },
    { "after": "m02", "threads": { "$issueThread": { "attributes": { "status": "進行中", "assignee": "p_kato", "priority": "高", "done": false } } } },
    { "after": "s05", "threads": { "$prThread": { "ball": { "kind": "us" } } } },
    { "after": "s06", "threads": { "$issueThread": { "ball": { "kind": "none" }, "signalCount": 2 } } },
    {
      "after": "m03",
      "threads": { "$issueThread": { "ball": { "kind": "none" }, "closedAtSource": true, "dismissed": false } },
      "views": [
        { "as": "u_kato", "thread": "$issueThread", "access": "full", "item": { "turn": { "kind": "none" } } },
        { "as": "u_kato", "threads": { "filter": "my_turn" }, "expect": [] }
      ]
    },
    {
      "after": "m04",
      "threads": { "$docThread": { "attributes": { "status": "未着手", "assignee": "p_nose", "priority": "低", "done": false } } },
      "views": [{ "as": "u_nose", "threads": { "filter": "my_turn" }, "expect": ["$docThread"] }]
    },
    { "after": "o02", "threads": { "$clientThread": { "ball": { "kind": "party", "partyIds": ["p_mori"] } } } },
    {
      "after": "o03",
      "threads": { "$clientThread": { "ball": { "kind": "party", "partyIds": ["p_mori"] }, "links": {} } },
      "views": [{ "as": "u_nose", "thread": "$clientThread", "access": "full", "candidates": ["$issueThread", "$prThread", "$docThread"] }]
    },
    {
      "after": "a03",
