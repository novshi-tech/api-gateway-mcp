{
  "ingest": {
    "s01": { "thread": "new", "needsResponse": true, "by": "no_match" },
    "o01": { "thread": "new", "needsResponse": null, "by": "no_match" },
    "o02": { "thread": "$compThread", "needsResponse": null, "by": "anchor" },
    "s02": { "thread": "$partnerThread", "needsResponse": false, "by": "anchor" },
    "o03": { "thread": "$compThread", "needsResponse": null, "by": "anchor" },
    "s03": { "thread": "$compThread", "needsResponse": false, "by": "anchor" },
    "s04": { "thread": "$compThread", "needsResponse": true, "by": "anchor" }
  },
  "checkpoints": [
    { "after": "o01", "threads": { "$partnerThread": { "ball": { "kind": "party", "partyIds": ["p_cleanco"] } } } },
    { "after": "o02", "threads": { "$compThread": { "ball": { "kind": "party", "partyIds": ["p_tanaka"] } } } },
    { "after": "s02", "threads": { "$partnerThread": { "ball": { "kind": "none" } } } },
    { "after": "s03", "threads": { "$compThread": { "ball": { "kind": "none" }, "signalCount": 4 } } },
    { "after": "a01", "threads": { "$compThread": { "dismissed": true, "activeSinceDismissed": false } } },
    { "after": "s04", "threads": { "$compThread": { "ball": { "kind": "none" }, "dismissed": true, "activeSinceDismissed": true, "signalCount": 5 } } }
  ],
  "final": {
    "threads": {
      "$compThread": { "ball": { "kind": "none" }, "dismissed": true, "activeSinceDismissed": false, "counterpartPartyIds": ["p_tanaka"], "signalCount": 4 },
      "$partnerThread": { "ball": { "kind": "none" }, "counterpartPartyIds": ["p_cleanco"], "signalCount": 2 },
      "$billingThread": { "dataSourceId": "ds_support", "title": "請求書の送付先変更", "ball": { "kind": "us" }, "counterpartPartyIds": ["p_tanaka"], "signalCount": 1 }
    },
    "threadCount": 3,
    "eventCounts": { "SignalObserved": 7, "SignalThreaded": 8, "ThreadDismissed": 1 }
  },
  "visibility": [
    { "as": "u_suzuki", "thread": "$compThread", "access": "full", "mustContain": ["乾拭き"] },
    { "as": "u_sato", "thread": "$billingThread", "access": "full", "mustContain": ["keiri@tanaka-bldg.example"] },
    { "as": "u_nvt", "thread": "$compThread", "access": null },
    { "as": "u_sato", "signals": 7 },
    { "as": "u_nvt", "signals": 0 },
    { "as": "u_sato", "threads": { "filter": "triage" }, "expect": ["$billingThread"] },
    { "as": "u_suzuki", "threads": { "filter": "all" }, "expect": ["$compThread", "$partnerThread", "$billingThread"] },
    { "ghostParty": "p_tanaka" }
  ]
